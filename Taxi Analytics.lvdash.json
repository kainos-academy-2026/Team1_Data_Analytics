{
  "datasets": [
    {
      "name": "07eb28fc",
      "displayName": "Monthly Revenue",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT d.year, d.month_name, d.month,\n       SUM(f.fare_amount) AS total_revenue,\n       COUNT(f.trip_key) AS total_trips\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_date d ON f.trip_start_date_key = d.date_key\nGROUP BY d.year, d.month_name, d.month\nORDER BY d.year, d.month",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "93979f04",
      "displayName": "Top 15 Zones by Revenue",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT z.zone_code AS pickup_zone,\n       COUNT(f.trip_key) AS trips,\n       SUM(f.fare_amount) AS revenue\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_zone z ON f.pickup_zone_key = z.zone_key\nGROUP BY z.zone_code\nORDER BY revenue DESC\nLIMIT 15",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "3cc13a0d",
      "displayName": "Average Wait Time by Day",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT d.day_name,\n       ROUND(AVG(f.expected_vs_actual_pickup_minutes_difference), 2) AS avg_wait_min,\n       ROUND(AVG(f.trip_duration_minutes), 2) AS avg_trip_duration\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_date d ON f.trip_start_date_key = d.date_key\nWHERE f.expected_vs_actual_pickup_minutes_difference IS NOT NULL\nGROUP BY d.day_name",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "93c098af",
      "displayName": "Revenue by Payment type & Zone",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT z.zone_code AS zone,\n       f.payment_type,\n       SUM(f.fare_amount) AS revenue\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_zone z ON f.pickup_zone_key = z.zone_key\nGROUP BY z.zone_code, f.payment_type\nORDER BY revenue DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
