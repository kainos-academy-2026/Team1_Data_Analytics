{
  "datasets": [
    {
      "name": "07eb28fc",
      "displayName": "Monthly Revenue",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT d.year, d.month_name, d.month,\n       SUM(f.fare_amount) AS total_revenue,\n       COUNT(f.trip_key) AS total_trips\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_date d ON f.trip_booked_for_date_key = d.date_key\nGROUP BY d.year, d.month_name, d.month\nORDER BY d.year, d.month",
        "dimensions": [
          {
            "name": "year",
            "expr": "year"
          },
          {
            "name": "month_name",
            "expr": "month_name"
          },
          {
            "name": "month",
            "expr": "month"
          },
          {
            "name": "total_revenue",
            "expr": "total_revenue"
          },
          {
            "name": "total_trips",
            "expr": "total_trips"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "93979f04",
      "displayName": "Top 15 Zones by Revenue",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT z.zone_code AS pickup_zone,\n       COUNT(f.trip_key) AS trips,\n       SUM(f.fare_amount) AS revenue\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_zone z ON f.pickup_zone_key = z.zone_key\nGROUP BY z.zone_code\nORDER BY revenue DESC\nLIMIT 15",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "3cc13a0d",
      "displayName": "Average Wait Time by Day",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT d.day_name,\n       ROUND(AVG(f.expected_vs_actual_pickup_minutes_difference), 2) AS avg_wait_min,\n       ROUND(AVG(f.trip_duration_minutes), 2) AS avg_trip_duration\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_date d ON f.trip_booked_for_date_key = d.date_key\nWHERE f.expected_vs_actual_pickup_minutes_difference IS NOT NULL\nGROUP BY d.day_name",
        "dimensions": [
          {
            "name": "day_name",
            "expr": "day_name"
          },
          {
            "name": "avg_wait_min",
            "expr": "avg_wait_min"
          },
          {
            "name": "avg_trip_duration",
            "expr": "avg_trip_duration"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "93c098af",
      "displayName": "Revenue by Payment type & Zone",
      "catalog": "students_data",
      "config": {
        "version": "1.1",
        "source": "SELECT z.zone_code AS zone,\n       f.payment_type,\n       SUM(f.fare_amount) AS revenue\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_zone z ON f.pickup_zone_key = z.zone_key\nGROUP BY z.zone_code, f.payment_type\nORDER BY revenue DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "trips_per_hour_dow",
      "displayName": "Trips per Hour by Day of Week",
      "config": {
        "version": "1.1",
        "source": "SELECT d.day_name,\n       HOUR(f.pickup_due_timestamp) AS hour_of_day,\n       COUNT(f.trip_key) AS num_trips\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_date d ON f.trip_booked_for_date_key = d.date_key\nGROUP BY d.day_name, HOUR(f.pickup_due_timestamp)\nORDER BY hour_of_day",
        "dimensions": [
          {
            "name": "day_name",
            "expr": "day_name"
          },
          {
            "name": "hour_of_day",
            "expr": "hour_of_day"
          },
          {
            "name": "num_trips",
            "expr": "num_trips"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "trips_by_year_month",
      "displayName": "Trips by Year and Month",
      "config": {
        "version": "1.1",
        "source": "SELECT d.year,\n       d.month_name,\n       d.month,\n       COUNT(f.trip_key) AS num_trips\nFROM students_data.team1_taxi.fact_trip f\nJOIN students_data.team1_taxi.dim_date d ON f.trip_booked_for_date_key = d.date_key\nWHERE d.year <= 2026\nGROUP BY d.year, d.month_name, d.month\nORDER BY d.year, d.month",
        "dimensions": [
          {
            "name": "year",
            "expr": "year"
          },
          {
            "name": "month_name",
            "expr": "month_name"
          },
          {
            "name": "month",
            "expr": "month"
          },
          {
            "name": "num_trips",
            "expr": "num_trips"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "card_vs_cash",
      "displayName": "Card vs Cash Payment Analysis",
      "config": {
        "version": "1.1",
        "source": "SELECT f.payment_type,\n       COUNT(f.trip_key) AS num_trips,\n       ROUND(SUM(f.fare_amount), 2) AS total_revenue,\n       ROUND(AVG(f.fare_amount), 2) AS avg_fare,\n       ROUND(AVG(f.distance), 2) AS avg_distance,\n       ROUND(AVG(f.trip_duration_minutes), 2) AS avg_duration_min,\n       ROUND(SUM(f.fare_amount) / COUNT(f.trip_key), 2) AS revenue_per_trip\nFROM students_data.team1_taxi.fact_trip f\nGROUP BY f.payment_type",
        "dimensions": [
          {
            "name": "payment_type",
            "expr": "payment_type"
          },
          {
            "name": "num_trips",
            "expr": "num_trips"
          },
          {
            "name": "total_revenue",
            "expr": "total_revenue"
          },
          {
            "name": "avg_fare",
            "expr": "avg_fare"
          },
          {
            "name": "avg_distance",
            "expr": "avg_distance"
          },
          {
            "name": "avg_duration_min",
            "expr": "avg_duration_min"
          },
          {
            "name": "revenue_per_trip",
            "expr": "revenue_per_trip"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
