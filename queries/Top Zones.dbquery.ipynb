   "outputs": [],
   "source": [
    "SELECT z.zone_code AS pickup_zone,\n",
    "       COUNT(f.trip_key) AS trips,\n",
    "       SUM(f.fare_amount) AS revenue\n",
    "FROM students_data.team1_taxi.fact_trip f\n",
    "JOIN students_data.team1_taxi.dim_zone z ON f.pickup_zone_key = z.zone_key\n",
    "GROUP BY z.zone_code\n",
    "ORDER BY revenue DESC\n",
    "LIMIT 15"
   ]
  }
 ],
